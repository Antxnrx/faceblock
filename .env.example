# --- Reverse image search -------------------------------------------------
# Which backend to use: serpapi (default) or vision.
FACEBLOCK_SEARCH_PROVIDER=serpapi

# SerpApi (Google Lens). Free tier, NO credit card required:
#   https://serpapi.com/users/sign_up
SERPAPI_API_KEY=

# Google Cloud Vision - only needed if FACEBLOCK_SEARCH_PROVIDER=vision.
# The first 1,000 units/month are free, but the Cloud project still needs
# billing enabled before the API will serve any request.
GOOGLE_VISION_API_KEY=

# --- Blockchain -----------------------------------------------------------
# Which testnet to anchor on: amoy (default) or sepolia.
FACEBLOCK_NETWORK=amoy

# Private key of a THROWAWAY testnet account. Never use a key that holds real
# funds - this file is plaintext and the key only needs faucet tokens.
FACEBLOCK_PRIVATE_KEY=

# Filled in by `python -m faceblock.cli deploy`.
FACEBLOCK_CONTRACT_ADDRESS=

# --- Optional overrides ---------------------------------------------------
# FACEBLOCK_RPC_URL=            # use your own RPC instead of the public one
# FACEBLOCK_FACE_THRESHOLD=0.45   # lower it to 0.363 (SFace's published
#                                 # value) to trade precision for recall
# FACEBLOCK_MAX_CANDIDATES=25
